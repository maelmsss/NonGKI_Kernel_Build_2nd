 #include <linux/user_namespace.h>
 #include <linux/proc_fs.h>
 #include <linux/proc_ns.h>
+#include <linux/cred.h>
+#include <linux/thread_info.h>
 
 /*
  * userns count is 1 for root user, 1 for init_uts_ns,
@@ -145,11 +147,44 @@
  *
  * If the user_struct could not be found, return NULL.
  */
+/*
+ * Port of fgetpriority (github.com/backslashxx/fgetpriority)
+ * Copyright (C) 2026 \xx <backslashxx>, GPL-2.0.
+ * Blinds cross-app uid liveness probes. A seccomp'd app querying another
+ * app uid through find_user() (getpriority/setpriority PRIO_USER and
+ * ioprio IOPRIO_WHO_USER) gets no user_struct. Self and non-app callers
+ * are left alone. SUSFS priority filter still runs before this call.
+ */
+#define FGP_MIN_APP_UID		10000
+#define FGP_AID_USER_OFFSET	100000
+#define FGP_HIDDEN_UID		(-1)
+
+static __always_inline bool fgp_should_swap(int who)
+{
+	int cuid;
+
+	if (unlikely(!test_thread_flag(TIF_SECCOMP)))
+		return false;
+
+	cuid = current_uid().val;
+	if (unlikely(cuid < FGP_MIN_APP_UID || who < FGP_MIN_APP_UID))
+		return false;
+
+	/* compare app ids across profiles */
+	cuid %= FGP_AID_USER_OFFSET;
+	who %= FGP_AID_USER_OFFSET;
+
+	return cuid != who;
+}
+
 struct user_struct *find_user(kuid_t uid)
 {
 	struct user_struct *ret;
 	unsigned long flags;
 
+	if (unlikely(fgp_should_swap(uid.val)))
+		uid = KUIDT_INIT(FGP_HIDDEN_UID);
+
 	spin_lock_irqsave(&uidhash_lock, flags);
 	ret = uid_hash_find(uid, uidhashentry(uid));
 	spin_unlock_irqrestore(&uidhash_lock, flags);
